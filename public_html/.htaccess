<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow access to existing files (like /assets/..., /api/...)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redirect everything else to index.html (SPA Routing)
  RewriteRule ^ index.html [L]
</IfModule>
